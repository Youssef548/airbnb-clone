{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "types": ["vitest/globals"]
  },
  "include": ["api/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "tests/setup.ts"],
  "exclude": ["node_modules"]
}
